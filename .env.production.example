# Production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#   # fill in every value below, then run the compose command in DEPLOYMENT.md
#
# .env.production is gitignored. Never commit the filled file: it holds the database password and
# the session/JWT secrets.

# Public hostname served by Caddy, and the contact address for Let's Encrypt. DNS for DOMAIN must
# already point at this server before you start, or certificate issuance will fail.
DOMAIN=deliveries.example.com
ACME_EMAIL=ops@example.com

# Strong, unique secrets. Generate each one with:  openssl rand -hex 32
# Use a different value for each line.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SESSION_SECRET=replace-with-a-long-random-session-secret
JWT_SECRET=replace-with-a-different-long-random-jwt-secret

# First admin. Only created when the database is empty. Use a real inbox and a strong password.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password

# Nominatim and OSRM require an honest User-Agent that identifies the deployment and a contact.
PROVIDER_USER_AGENT=RIMsDeliveryPricing/1.0 (contact: ops@example.com)

# Optional overrides, only if RIMs uses them. Leave commented to use the defaults.
# CORS_ORIGINS is derived from DOMAIN by the compose file.
# PROVIDER_BASE_URL=
# MAPS_API_KEY=
