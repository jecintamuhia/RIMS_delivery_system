# Docker Compose deployment variables. Copy to .env and replace every required value.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SESSION_SECRET=replace-with-a-long-random-session-secret
BOOTSTRAP_ADMIN_EMAIL=operator@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-long-admin-password
PROVIDER_USER_AGENT=RIMsDeliveryPricing/1.0 (contact: operations@example.com)
CORS_ORIGINS=http://localhost:8080
WEB_PORT=8080
# The api sits behind the bundled nginx, which rewrites X-Forwarded-For to the true client IP, so
# the rate limiter can tell clients apart. Leave this true for the compose stack.
TRUST_FORWARDED_FOR=true
# ENVIRONMENT=production requires HTTPS and a Secure session cookie. For a local HTTP demo served
# from http://localhost:8080 set ENVIRONMENT=staging and SESSION_HTTPS_ONLY=false, otherwise the
# browser will refuse to send the admin session cookie and sign-in will loop.
ENVIRONMENT=production
SESSION_HTTPS_ONLY=true
