# Docker Compose deployment variables. Copy to .env and replace every required value.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SESSION_SECRET=replace-with-a-long-random-session-secret
BOOTSTRAP_ADMIN_EMAIL=operator@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-long-admin-password
PROVIDER_USER_AGENT=RIMsDeliveryPricing/1.0 (contact: operations@example.com)
CORS_ORIGINS=http://localhost:8080
WEB_PORT=8080
ENVIRONMENT=production
SESSION_HTTPS_ONLY=true
