# Production environment for the API when it runs on a managed host (Render, etc.).
# Set these in the host's dashboard - never commit real values. The frontend on Vercel
# proxies /api/* to this service, so requests are same-origin and CORS is a safety net only.
ENVIRONMENT=production
DEBUG=false
DOCS_ENABLED=false

# Managed PostgreSQL. The app upgrades a plain postgresql:// URL to asyncpg automatically.
# Render's "Internal Connection String" can be pasted here as-is.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# Optional: point at a managed Redis for a shared cache/rate-limit store. Omit to use
# the in-process cache, which is fine for a single instance.
# REDIS_URL=redis://HOST:6379

GEOCODING_PROVIDER=osm
ROUTING_PROVIDER=osm
PROVIDER_USER_AGENT=RIMsDeliveryPricing/1.0 (contact: operations@rimssuppliesandhardware.co.ke)
COUNTRY_CODE=ke

# 64+ character random values. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-production-secret
JWT_SECRET=replace-with-a-different-long-random-production-secret
SESSION_HTTPS_ONLY=true
CSRF_PROTECTION=true

# The public site origins. Only needed as a safety net because the browser calls the API
# through the Vercel proxy on the same origin.
CORS_ORIGINS=https://rimssuppliesandhardware.co.ke,https://www.rimssuppliesandhardware.co.ke

# Trust X-Forwarded-For from the platform's proxy so rate limiting sees real client IPs.
TRUST_FORWARDED_FOR=true

# Optional first-run admin. Leave blank to create it later from the app.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Distance-based fallback pricing (pricing model B), seeded once on a fresh install.
# AUTO_SEED_DISTANCE_PRICING=true
# DEFAULT_DISTANCE_RATE_PER_KM=150
