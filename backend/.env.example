# Copy to backend/.env for local API development. Never use these development values in production.
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./rims_delivery.db

# Configure independently when deploying across hosts. OSM is keyless but rate-limited.
GEOCODING_PROVIDER=osm
ROUTING_PROVIDER=osm
PROVIDER_USER_AGENT=RIMsDeliveryPricing/1.0 (contact: replace-with-operations-email)
COUNTRY_CODE=ke

# Development-only example secrets. Replace with random secrets outside local development.
SESSION_SECRET=replace-with-a-long-random-development-secret
JWT_SECRET=replace-with-a-long-random-development-secret
SESSION_HTTPS_ONLY=false
CSRF_PROTECTION=true
CORS_ORIGINS=http://localhost:5173

# Public rate budgets (per client, fixed window). Location search and route previews each
# spend a third-party geocoding/routing call, so they carry their own tighter bucket.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_AUTH_REQUESTS=10
# RATE_LIMIT_AUTH_WINDOW_SECONDS=300
# RATE_LIMIT_GEO_REQUESTS=30
# RATE_LIMIT_GEO_WINDOW_SECONDS=60

# Optional first-run local admin. Use a unique password and do not commit an actual .env file.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Distance-based fallback pricing (pricing model B). A delivery location outside the official
# destination price list is charged this rate per kilometre. Seeded once, on a fresh install,
# as an activatable rate in Admin > Dynamic pricing; existing configurations are never overridden.
# AUTO_SEED_DISTANCE_PRICING=true
# DEFAULT_DISTANCE_RATE_PER_KM=150
